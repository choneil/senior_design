  "ATMEGA2560-16AU": {
    "name": "ATmega2560 8-bit AVR microcontroller",
    "source": "Microchip/Atmel 2549Q datasheet: Block Diagram (Fig. 2-1, p. 5), I/O Pin Equivalent Schematic (Fig. 13-1, p. 67), General Digital I/O (Fig. 13-2, p. 68), 100A package drawing (p. 412)",
    "notes": "Every port pin is drawn with the pin circuit of Figs. 13-1/13-2: clamp diodes to VCC and GND, the switchable pull-up (PMOS + Rpu), the tri-state output driver and the Schmitt-trigger input. The core blocks of Fig. 2-1 each hold one representative textbook transistor circuit for their job, not Microchip's layout: a mirror-adder carry stage for the CPU's ALU, floating-gate NOR flash and two-transistor EEPROM cells, 6T SRAM cells, transmission-gate flip-flops for the timers, serial ports, port registers, JTAG and XRAM, a bandgap, a SAR capacitor array, comparators, and ring and crystal oscillators. Die and paddle sizes are not published.",
    "caption": "ATmega2560 · I/O ring after Figs. 13-1/13-2, core after Fig. 2-1 · blocks: textbook transistor circuits · floorplan illustrative",
    "ring": "avr",
    "ringDepth": { "vcc": 72, "gnd": 165, "cell": 300 },
    "pkg": { "kind": "qfp", "die": [4.6, 4.6], "paddle": [6.0, 6.0], "tip": [3.7, 3.7], "tipSpan": [3.3, 3.3],
             "frameZ": 0.45, "frameT": 0.127, "leadW": 0.22, "innerW": 0.13, "dieT": 0.25, "loop": 0.18, "wireR": 0.012,
             "margin": 50, "inset": 25, "padS": 26, "tex": 4096, "ui": 0.55, "capY": 12, "capFont": 9 },
    "pins": { "10": "VCC", "11": "GND", "31": "VCC", "32": "GND", "61": "VCC", "62": "GND", "80": "VCC", "81": "GND",
              "30": "RESET", "33": "XTAL2", "34": "XTAL1", "98": "AREF", "99": "GND", "100": "AVCC" },
